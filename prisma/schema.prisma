// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  authenticators   Authenticator[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Passkeys (WebAuthn). Field names are fixed by the Auth.js adapter contract —
// @auth/prisma-adapter looks up `authenticator` by `credentialID` and updates
// `counter` by name, so these cannot be renamed.
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  // Not part of the adapter contract. The adapter strips undefined values
  // before create, so an optional label and a defaulted timestamp are safe to
  // add, and they let the settings page show which device a passkey belongs to.
  name      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  instagramId       String    @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean   @default(false)
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations       Automation[]
  dmLogs            DmLog[]
  linkClicks        LinkClick[]
  followerSnapshots FollowerSnapshot[]
  audienceSnapshots AudienceSnapshot[]
  accountMetrics    AccountMetricSnapshot[]
  mediaMetrics      MediaMetricSnapshot[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

/// Which audience a demographic snapshot describes.
enum AudienceMetric {
  /// follower_demographics — who follows the account.
  FOLLOWER
  /// engaged_audience_demographics — who actually interacted.
  ENGAGED
}

enum AudienceDimension {
  AGE
  GENDER
  CITY
  COUNTRY
}

/// One bucket of one demographic breakdown, captured on one day.
///
/// Instagram serves demographics as a lifetime snapshot over a fixed timeframe
/// and keeps no history of its own, so a value not recorded here is gone. The
/// whole point of this table is that a month from now there is a trend to look
/// at rather than a single number.
///
/// `value` is a share of the top-45 buckets Instagram returns, never a true
/// total — the long tail is truncated upstream and cannot be recovered.
model AudienceSnapshot {
  id                 String            @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this capture belongs to.
  date               DateTime          @db.Date
  metric             AudienceMetric
  dimension          AudienceDimension
  /// The label exactly as Instagram returns it: "25-34", "F", "US", "Montreal".
  bucket             String
  value              Int
  createdAt          DateTime          @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date, metric, dimension, bucket])
  @@index([instagramAccountId, metric, dimension, date])
}

/// A day of one account-level metric, optionally split by a breakdown.
///
/// `breakdown` is the dimension name ("follow_type", "media_product_type") and
/// `bucket` the value within it ("follower", "non_follower", "REELS"). A row
/// with both null is the un-split total for that metric.
model AccountMetricSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  date               DateTime @db.Date
  /// reach, views, total_interactions, accounts_engaged, profile_links_taps…
  metric             String
  /// Empty string, not null, for the un-split total. Postgres treats NULL as
  /// distinct from NULL in a unique constraint, so a nullable pair here would
  /// let the nightly upsert miss its own previous row and insert a duplicate
  /// every single run.
  breakdown          String   @default("")
  bucket             String   @default("")
  value              Int
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date, metric, breakdown, bucket])
  @@index([instagramAccountId, metric, date])
}

/// Point-in-time metrics for one post.
///
/// Repeated captures give a decay curve — how quickly a post stopped being
/// served — which is the only way to tell a post that did 50k in a day from
/// one that did 50k over a month. Media fields are denormalised so the record
/// survives the post being deleted on Instagram.
model MediaMetricSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  mediaId            String
  capturedAt         DateTime @default(now())

  mediaType   String?
  permalink   String?
  caption     String?
  publishedAt DateTime?

  views             Int?
  reach             Int?
  likes             Int?
  comments          Int?
  saved             Int?
  shares            Int?
  totalInteractions Int?
  /// Per-media `follows` — which post actually gained followers, as opposed to
  /// which one got the most likes. Feed and story only; reels do not report it.
  follows           Int?
  profileVisits     Int?
  /// Reels only, milliseconds. Meaningless without the clip length — see
  /// lib/insights/queries for the retention calculation.
  avgWatchTimeMs    Int?
  skipRate          Float?

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, capturedAt])
  @@index([mediaId, capturedAt])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                    String
  goal                    String?
  /// Mirror of the primary (oldest) row in `posts`, kept in sync on every write.
  /// The set in `posts` is the source of truth for matching — these two columns
  /// only survive so the CSV importer and the public report keep working, and
  /// are due for removal once those read `posts` directly.
  postId                  String?
  postUrl                 String?
  pendingNextReel         Boolean  @default(false)
  matchAnyPost            Boolean  @default(false)
  /// Saved targeting rule (see lib/campaigns/post-rules.ts). When set, matching
  /// posts are enrolled into `posts` with source RULE — on first sighting of a
  /// new media in the worker, and by the periodic sweep. null = no rule.
  postRule                Json?
  keywords                String[]
  matchAnyWord            Boolean  @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled        Boolean  @default(false)
  dmMessage               String
  openingDmEnabled        Boolean  @default(false)
  openingDmMessage        String?
  openingDmButtonLabel    String?
  linkButtonLabel         String?
  requireFollow           Boolean  @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean  @default(false)
  followUpMessage         String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes    Int      @default(0)
  publicReplyEnabled      Boolean  @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[] @default([])
  isActive                Boolean  @default(true)
  wholeWordMatch          Boolean  @default(true)
  reportShareSlug         String?  @unique
  reportShareEnabled      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  posts            AutomationPost[]
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

/// How a post came to be part of a campaign. Also the tiebreak when several
/// campaigns match one comment: Instagram allows exactly one private reply per
/// comment ever, so the most specific campaign wins (MANUAL > RULE/NEXT_REEL >
/// matchAnyPost). See specificity() in lib/queue/dm-worker.ts.
enum PostSource {
  MANUAL
  RULE
  NEXT_REEL
}

/// One post covered by one campaign. Replaces the old single Automation.postId
/// as the source of truth for "which media triggers this campaign".
model AutomationPost {
  id           String     @id @default(cuid())
  automationId String
  mediaId      String
  source       PostSource @default(MANUAL)
  /// Removed by hand after a rule added it. Kept as a row rather than deleted so
  /// the next rule sweep doesn't just add it straight back.
  excluded     Boolean    @default(false)

  // Graph metadata cached at selection time. Without this every surface that
  // renders a campaign has to re-download the account's media list to find one
  // thumbnail — and a post older than that page renders nothing at all.
  permalink    String?
  thumbnailUrl String?
  mediaUrl     String?
  mediaType    String? // REEL | IMAGE | CAROUSEL | VIDEO
  caption      String?
  postedAt     DateTime?

  addedAt DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, mediaId])
  // The webhook hot path looks up campaigns by media id on every comment.
  @@index([mediaId])
  @@index([automationId, excluded])
  // The polling sweep collects covered media newest-first within the lookback.
  @@index([postedAt])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  /// Media the comment was on. Null for the inbound-DM trigger, which has no
  /// media. A campaign can cover many posts, so this can no longer be inferred
  /// from the automation — it is what makes the per-post breakdown possible.
  postId         String?
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  // Composite indexes for the analytics reads, which all filter on some
  // combination of workspace, status and time. A bare @@index([status]) was
  // never worth planning around — the column has five distinct values across
  // the whole table — so the leading workspaceId is what makes these usable.
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, instagramAccountId, createdAt])
  @@index([automationId, status])
  // Per-post breakdown on the campaign detail page.
  @@index([automationId, postId])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
